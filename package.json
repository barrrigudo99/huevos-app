    "express": "^5.2.1",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.4",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}
