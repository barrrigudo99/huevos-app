{
  "name": "futbol7-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env server/migrate-to-supabase.mjs",
    "dev:full": "concurrently -n API,WEB -c blue,green \"npm:server\" \"npm:dev\"",
